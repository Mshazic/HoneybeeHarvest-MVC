@model OrderCreateViewModel
@{
    ViewData["Title"] = "Order Honey";
}

<section class="page-shell section-space narrow-shell">
    <p class="eyebrow">MVC order form</p>
    <h1>Order honey</h1>
    <p>Submit a fictional order to preview the posted values.</p>

    <form asp-action="Create" method="post" class="order-form">
        <div asp-validation-summary="ModelOnly" class="validation-message"></div>

        <div class="field-group">
            <label asp-for="Input.CustomerName">Name</label>
            <input asp-for="Input.CustomerName" />
            <span asp-validation-for="Input.CustomerName" class="validation-message"></span>
        </div>

        <div class="field-group">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" />
            <span asp-validation-for="Input.Email" class="validation-message"></span>
        </div>

        <div class="field-group">
            <label asp-for="Input.ProductName">Honey</label>
            <select asp-for="Input.ProductName">
                <option value="">Choose a product</option>
                @foreach (var product in Model.Products)
                {
                    <option value="@product.Name">@product.Name</option>
                }
            </select>
            <span asp-validation-for="Input.ProductName" class="validation-message"></span>
        </div>

        <div class="field-group">
            <label asp-for="Input.Quantity">Quantity</label>
            <input asp-for="Input.Quantity" min="1" max="12" />
            <span asp-validation-for="Input.Quantity" class="validation-message"></span>
        </div>

        <button class="button" type="submit">Save order</button>
    </form>

    @if (ViewData["Submitted"] is true)
    {
        <div class="empty-state">
            <h2>Submitted order preview</h2>
            <p><strong>Name:</strong> @Model.Input.CustomerName</p>
            <p><strong>Email:</strong> @Model.Input.Email</p>
            <p><strong>Honey:</strong> @Model.Input.ProductName</p>
            <p><strong>Quantity:</strong> @Model.Input.Quantity</p>
        </div>
    }
</section>