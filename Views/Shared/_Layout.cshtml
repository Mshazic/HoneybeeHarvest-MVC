<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Honeybee Harvest</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <header class="site-header">
        <nav class="nav-shell" aria-label="Primary navigation">
            <a class="brand" asp-controller="Home" asp-action="Index">Honeybee Harvest</a>
            <div class="nav-links">
                <a asp-controller="Home" asp-action="Index">Catalog</a>
                <a asp-controller="Orders" asp-action="Create">Order Honey</a>
                <a asp-controller="Orders" asp-action="Index">Saved Orders</a>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <p>Honeybee Harvest is a fictional learning project.</p>
    </footer>
</body>
</html>